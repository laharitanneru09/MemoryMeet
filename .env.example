# 1) Groq: https://console.groq.com  -> API Keys -> Create
GROQ_API_KEY=your_groq_key_here

# 2) Hindsight Cloud: https://ui.hindsight.vectorize.io
#    Click "Connect" (top bar) -> Create API Key
HINDSIGHT_API_KEY=your_hindsight_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Optional: change models if one gives errors
PRIMARY_MODEL=openai/gpt-oss-120b
FALLBACK_MODEL=qwen/qwen3-32b
